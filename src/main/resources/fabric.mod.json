{
  "schemaVersion": 1,
  "id": "meteor-purple-edition",
  "version": "${version}",
  "name": "Meteor Purple Edition",
  "description": "Purple appearance profiles, synchronized HUD, and OpSec integration for the real Meteor and Catppuccin addons.",
  "authors": ["Meteor Purple Edition contributors"],
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": { "meteor": ["dev.meteorpurple.PurpleAddon"] },
  "custom": { "meteor-client:color": "180,160,255" },
  "depends": {
    "minecraft": "26.2",
    "java": ">=25",
    "fabricloader": ">=0.19.3",
    "meteor-client": "~26.2",
    "catppuccin-addon": "*"
  },
  "suggests": { "opsec": "*", "glazed": "*" }
}
