{
  "schemaVersion": 1,
  "id": "meteor-purple-edition",
  "version": "${version}",
  "name": "Meteor Purple Edition",
  "description": "Meteor and Catppuccin with a fully redesigned classic Zenith UI, ten custom icon families, animated Meteor logo, rounded typography, expressive motion and optional game UI feedback.",
  "authors": ["Meteor Purple Edition contributors"],
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": { "meteor": ["dev.meteorpurple.PurpleAddon"] },
  "mixins": ["purple.mixins.json"],
  "custom": { "meteor-client:color": "180,160,255" },
  "depends": {
    "minecraft": "26.2",
    "java": ">=25",
    "fabricloader": ">=0.19.3",
    "meteor-client": ">=26.2-0 <26.3",
    "catppuccin-addon": "*"
  },
  "suggests": { "opsec": "*", "glazed": "*", "exploitpreventer": "*" }
}
